# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Auth.js secret (generate one with: npx auth secret)
AUTH_SECRET="replace-with-a-random-secret"

# Resend (magic-link sign-in and alert emails)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="La Polla <noreply@example.com>"
ALERT_EMAIL="you@example.com"

# API-Football
API_FOOTBALL_KEY="your-api-football-key"
API_FOOTBALL_LEAGUE_ID="your-league-id"
API_FOOTBALL_SEASON_YEAR="2026"

# Highlightly (RapidAPI)
HIGHLIGHTLY_API_KEY="your-highlightly-key"
HIGHLIGHTLY_LEAGUE_ID="your-league-id"

# Upstash QStash (scheduled cron jobs)
QSTASH_CURRENT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxx"
QSTASH_NEXT_SIGNING_KEY="sig_xxxxxxxxxxxxxxxx"

# Shared secret for admin and cron routes (header x-cron-secret)
CRON_SHARED_SECRET="replace-with-a-random-secret"

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
