// Prisma schema for La Polla BetPlay
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js v5 (@auth/prisma-adapter) required tables ---

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  favoriteTeamId String?
  createdAt      DateTime  @default(now())

  favoriteTeam Team?        @relation("FavoriteTeam", fields: [favoriteTeamId], references: [id])
  accounts     Account[]
  sessions     Session[]
  memberships  Membership[]
  predictions  Prediction[]
  createdClubs Club[]       @relation("ClubCreator")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Clubs ---

enum MembershipRole {
  ADMIN
  MEMBER
}

model Club {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  createdById String
  createdAt   DateTime @default(now())

  createdBy   User         @relation("ClubCreator", fields: [createdById], references: [id])
  memberships Membership[]
}

model Membership {
  id       String         @id @default(cuid())
  userId   String
  clubId   String
  role     MembershipRole @default(MEMBER)
  joinedAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([userId, clubId])
  @@index([clubId])
}

// --- Global league data (shared across every club, synced once) ---

model Season {
  id         String  @id @default(cuid())
  name       String
  externalId String? @unique
  isActive   Boolean @default(true)

  jornadas Jornada[]
}

model Jornada {
  id       String  @id @default(cuid())
  seasonId String
  number   Int
  label    String?

  season  Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matches Match[]

  @@unique([seasonId, number])
}

model Team {
  id         String  @id @default(cuid())
  name       String  @unique
  shortName  String?
  externalId String? @unique
  // Set once at creation and never touched by the sync job again, so a
  // team's badge color/initials stay stable even if the API tweaks its name.
  badgeSeed  String

  homeMatches   Match[] @relation("HomeTeam")
  awayMatches   Match[] @relation("AwayTeam")
  favoritedBy   User[]  @relation("FavoriteTeam")
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED
}

enum ResultSource {
  API
  MANUAL
}

model Match {
  id        String      @id @default(cuid())
  jornadaId String
  homeTeamId String
  awayTeamId String
  kickoff   DateTime
  status    MatchStatus @default(SCHEDULED)
  homeScore Int?
  awayScore Int?
  // Null until a score exists. MANUAL freezes the row against the sync job.
  resultSource      ResultSource?
  externalFixtureId String?       @unique
  lastSyncedAt      DateTime?
  // Only meaningful while status = LIVE; cleared once FINISHED.
  liveMinute Int?
  livePeriod String?

  jornada     Jornada      @relation(fields: [jornadaId], references: [id], onDelete: Cascade)
  homeTeam    Team         @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam    Team         @relation("AwayTeam", fields: [awayTeamId], references: [id])
  predictions Prediction[]

  @@index([kickoff])
  @@index([jornadaId])
  @@index([status])
}

// One prediction per (user, match) — global, not per-club — so a member's
// pick counts the same way in every club they belong to.
model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([matchId])
}
